# FastAPI Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/codebase_rag

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings Model
EMBEDDING_MODEL=sentence-transformers/code-bge-base-en-v1
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# LLM Provider (openai or anthropic)
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo

# Anthropic Settings
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Retrieval Settings
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANKER_TOP_K=5
RRF_K=60

# Context Settings
MAX_CONTEXT_TOKENS=6000
MAX_SOURCE_CHARS=50000

# File Processing
MAX_UPLOAD_SIZE_MB=500
TEMP_UPLOAD_DIR=/tmp/codebase_rag

# Supported Languages
SUPPORTED_LANGUAGES=python,java,javascript,typescript,cpp,go,rust,csharp
